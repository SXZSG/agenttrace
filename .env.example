# Copy to .env for scripts/run_api_windows.ps1, or set server process variables.
AGENTTRACE_MODE=mock
# Required only for llm mode. Never put a real key in this example or in chat.
OPENAI_API_KEY=
AGENTTRACE_MODEL=
# Optional OpenAI-compatible Chat Completions endpoint:
# OPENAI_BASE_URL=https://api.openai.com/v1
AGENTTRACE_DB_PATH=agenttrace.sqlite3
# DeepSeek tool calling with the current non-reasoning history protocol:
# OPENAI_BASE_URL=https://api.deepseek.com
# AGENTTRACE_MODEL=deepseek-flash
# AGENTTRACE_DISABLE_THINKING=1
